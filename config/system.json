    "urgent": { "label": "Urgent", "color": "#f59e0b", "weights": { "time": 0.5, "reliability": 0.2, "cost": 0.2, "balance": 0.1 } },
    "emergency": { "label": "Emergency", "color": "#ef4444", "weights": { "time": 0.7, "reliability": 0.2, "balance": 0.1, "cost": 0.0 } }
  },
  "shelfLife": {

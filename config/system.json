{
  "simulation": {
    "tickInterval": 5000,
    "inventoryFluctuationInterval": 10000,
    "trafficUpdateInterval": 8000,
    "emergencyProbability": 0.3,
    "maxActiveEmergencies": 5
  },
  "routing": {
